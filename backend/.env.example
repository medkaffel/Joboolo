# Joboolo backend — variables d'environnement (P0-001)
# ----------------------------------------------------------------------
# N'UTILISEZ JAMAIS DE VRAI SECRET DANS CE FICHIER.
# Ce fichier documente UNIQUEMENT les NOMS des variables et leur rôle.
# Copiez-le en backend/.env (ignoré par git) et remplissez vos valeurs réelles.
# Les secrets doivent être fournis via l'API des secrets de l'environnement de
# déploiement, jamais commités.

# ----------------------------------------------------------------------
# Environnement (Obligatoire dans TOUS les environnements)
# Valeurs autorisées : development | test | production
# S'il est absent ou invalide, le backend refuse de démarrer (fail-fast).
APP_ENV=development

# ----------------------------------------------------------------------
# Secret de signature JWT (Obligatoire dans TOUS les environnements)
# En test : valeur factice injectée explicitement (jamais un secret réel).
# Aucun fallback n'existe dans le code : sans cette variable, le backend refuse
# de démarrer.
SECRET_KEY=

# ----------------------------------------------------------------------
# Clés Stripe (Obligatoires UNIQUEMENT en production)
# En development/test elles peuvent être absentes ; tout appel Stripe sans clé
# renvoie une erreur explicite (503) sans exposer de secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------
# Base de données (convention existante ; exemples de noms uniquement)
# MONGO_URL=
# DB_NAME=

# ----------------------------------------------------------------------
# URL canonique de l'application (P0-008) — origine autorisée du tracker
# d'alertes et de la génération des emails. Absente/vide => défaut historique.
# FRONTEND_URL=https://joboolo.fr

# Préproduction : APP_ENV=test. Ce mode n'isole pas les services à lui seul.
# Renseigner une base dédiée sur un replica set, jamais une base de production.
# DB_NAME=joboolo_preproduction
# CORS : origines exactes séparées par virgules, sans chemin ni slash final.
# Absent/vide => aucun accès cross-origin autorisé. Configurer AVANT activation.
CORS_ALLOWED_ORIGINS=
# false pour la recette initiale. Défaut : false en test, true ailleurs.
SCHEDULER_ENABLED=false
# APP_PUBLIC_URL=
# ADMIN_EMAIL=
# EMERGENT_LLM_KEY=
# RESEND_API_KEY=
# SENDER_EMAIL=
# Frontend (variable de BUILD, pas un secret) : REACT_APP_BACKEND_URL
# URL backend sans suffixe /api. FRONTEND_URL doit aussi router /api/alerts/track.
